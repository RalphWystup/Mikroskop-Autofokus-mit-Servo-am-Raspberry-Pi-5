[Desktop Entry]
Type=Application
Name=Mikroskop-Fokus
Comment=Bedienseite des Autofokus als Fenster beim Anmelden (Firefox mit eigenem Profil; Chromium bleibt in der Remote-Sitzung weiss)
Exec=sh -c 'sleep 6; firefox --no-remote --profile /home/pi/.mozilla/fokus --new-window http://localhost:8090 --width 1000 --height 640'
Terminal=false
X-GNOME-Autostart-enabled=true
