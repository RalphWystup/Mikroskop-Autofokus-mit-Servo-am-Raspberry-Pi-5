[Unit]
Description=Mikroskop-Autofokus (Kamera, Servo, Bedienseite Port 8090)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/Desktop/autofokus4
ExecStart=/usr/bin/python3 -u /home/pi/Desktop/autofokus4/autofokus4.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
